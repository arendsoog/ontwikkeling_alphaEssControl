# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Scratch Home Assistant config generated by scripts/setup and scripts/develop
# (the latter symlinks the integration into config/custom_components/)
config/

# Legacy C reference implementation, kept locally only
/.old c code/

# Frank Energie tariff data, kept locally only
/.tarieven_frank/

# Per-machine root certificates trusted by scripts/trust-local-ca
# (e.g. a local antivirus's HTTPS-scanning root)
/.devcontainer/local-ca/

# Editors: only the shared VS Code files are tracked (the negations below
# need the directory's contents ignored first to have any effect)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

.idea/

# Local tool settings, secrets and logs
.claude/
.env
*.log

# OS
.DS_Store
Thumbs.db
