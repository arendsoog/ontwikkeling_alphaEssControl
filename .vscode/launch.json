{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Home Assistant (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant",
            "args": ["-c", "config", "--debug"],
            "justMyCode": false
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v"],
            "justMyCode": false
        }
    ]
}
