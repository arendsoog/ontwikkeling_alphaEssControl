#!/usr/bin/env bash
# Sets up the Python dependencies and a scratch Home Assistant config
# for running/debugging the integration inside the devcontainer.
set -e

cd "$(dirname "$0")/.."

# Before pip (system store) and again after it (certifi's bundle, which
# Home Assistant uses and pip may just have installed or replaced), so
# HTTPS works behind a host antivirus that intercepts TLS (see the script).
bash scripts/trust-local-ca

# The stable Home Assistant release the dev environment runs, same as
# production. The test package (requirements-test.txt) can lag behind on
# a beta of it; installing HA on top keeps dev on the real release.
HA_VERSION=2026.10.0

python3 -m pip install --upgrade pip
pip3 install -r requirements-test.txt
pip3 install "homeassistant==${HA_VERSION}"

bash scripts/trust-local-ca

mkdir -p config
if [ ! -f config/configuration.yaml ]; then
    hass --script ensure_config -c config
fi

if ! grep -q "logger:" config/configuration.yaml 2>/dev/null; then
    cat <<'EOF' >> config/configuration.yaml

logger:
  default: info
  logs:
    custom_components.alpha_ess_local: debug
EOF
fi
